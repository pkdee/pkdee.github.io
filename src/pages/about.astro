---
import ExternalLinkIcon from '../assets/icons/external-link-primary.svg';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagChip from '../components/blog/TagChip.astro';
import { getPublishedPosts, summarizeTags } from '../lib/posts';
import { SITE } from '../lib/site';

// 소개(DESIGN.md #5.7): 자기소개, 관심 분야, 연락처. 연락처는 값이 있는 것만 보여 준다.
const { intro, interests, email } = SITE.about;
// 공개 글이 없는 태그는 태그 페이지가 없으므로 링크 없는 칩으로 보여 준다.
const taggedNames = new Set(summarizeTags(await getPublishedPosts()).map((tag) => tag.name));
const hasContact = Boolean(SITE.githubUrl || email);
const linkClass = 'flex items-center gap-xxs self-start text-body text-primary underline';
---

<BaseLayout title="About" description={intro}>
  <div class="px-(--layout-gutter) pt-lg pb-xxxl md:pt-xxl">
    <div class="mx-auto flex max-w-article flex-col gap-lg break-keep md:gap-xl">
      <h1 lang="en" class="text-heading-lg text-text md:text-heading-xl">About</h1>
      <p class="text-body text-text">{intro}</p>

      {
        interests.length > 0 && (
          <section class="flex flex-col gap-md">
            <h2 class="text-heading-lg text-text">관심 분야</h2>
            <ul class="flex flex-wrap gap-xs">
              {interests.map((name) => (
                <li>
                  <TagChip name={name} link={taggedNames.has(name)} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        hasContact && (
          <section class="flex flex-col gap-md">
            <h2 class="text-heading-lg text-text">연락처</h2>
            {SITE.githubUrl && (
              <a href={SITE.githubUrl} class={linkClass} rel="me">
                GitHub
                <span aria-hidden="true">
                  <ExternalLinkIcon />
                </span>
                <span class="sr-only">(외부 사이트)</span>
              </a>
            )}
            {email && (
              <a href={`mailto:${email}`} class={linkClass}>
                {email}
              </a>
            )}
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>
