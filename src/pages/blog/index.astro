---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListView from '../../components/blog/BlogListView.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../lib/posts';

// 1페이지. 2페이지부터는 blog/page/[page].astro가 만든다(TECH.md #6.9).
const posts = await getPublishedPosts();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<BaseLayout title="Blog">
  <BlogListView
    posts={posts.slice(0, POSTS_PER_PAGE)}
    allPosts={posts}
    currentPage={1}
    lastPage={lastPage}
  />
</BaseLayout>
