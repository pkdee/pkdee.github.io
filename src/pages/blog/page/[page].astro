---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogListView from '../../../components/blog/BlogListView.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../../lib/posts';

// [page]는 rest 매개변수가 아니라 paginate()가 /blog/page/1/도 만든다.
// 1페이지는 blog/index.astro가 맡으므로 뺀다(TECH.md #6.9).
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    ({ props }) => props.page.currentPage > 1,
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props as Props;
---

<BaseLayout title={`Blog ${page.currentPage}페이지`}>
  <BlogListView
    posts={page.data}
    total={page.total}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
  />
</BaseLayout>
