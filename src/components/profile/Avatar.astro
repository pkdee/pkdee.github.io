---
import { Image } from 'astro:assets';
import UserIcon from '../../assets/icons/user.svg';
import { SITE } from '../../lib/site';

interface Props {
  /** 크기 클래스. 예: size-16 */
  class?: string;
}

const { class: className } = Astro.props;
const { avatar } = SITE.profile;

// 프로필 사진(DESIGN.md #8.17). 바로 옆에 저자 이름이 있으므로 장식으로 보고 읽지 않게 한다.
// 사진이 없으면 Surface 원 안에 사람 아이콘(30px)을 둔다.
---

<span
  class:list={[
    'flex shrink-0 items-center justify-center overflow-hidden rounded-pill border border-border bg-surface',
    className,
  ]}
  aria-hidden="true"
>
  {
    avatar ? (
      <Image src={avatar} alt="" width={144} height={144} class="size-full object-cover" />
    ) : (
      <UserIcon width={30} height={30} />
    )
  }
</span>
