---
import SocialLinks from '../profile/SocialLinks.astro';
import { SITE } from '../../lib/site';

const year = new Date().getFullYear();

// 푸터(DESIGN.md #8.17). 왼쪽에 저작권 표기, 오른쪽에 외부 프로필과 RSS 아이콘 링크를 둔다.
// 모바일은 두 줄로 쌓는다.
---

<footer class="border-t border-border bg-background px-(--layout-gutter) py-lg md:py-xl">
  <div
    class="mx-auto flex max-w-site flex-col gap-sm md:flex-row md:items-center md:justify-between"
  >
    <p class="text-body-sm text-muted">© {year} {SITE.author}</p>
    <SocialLinks rss />
  </div>
</footer>
