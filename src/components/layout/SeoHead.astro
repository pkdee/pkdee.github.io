---
import { SITE } from '../../lib/site';

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date | undefined;
  tags: readonly string[];
}

interface Props {
  /** 문서 제목(사이트 이름 포함) */
  title: string;
  description: string;
  /** 절대 URL. 운영 주소(site) 기준이다(ARCHITECTURE.md #8.3). */
  canonical: URL;
  /** 게시물이면 Open Graph article 정보를 함께 쓴다. */
  article?: ArticleMeta | undefined;
  /** 대표 이미지 절대 URL. 없으면 og:image를 쓰지 않는다. */
  image?: { url: URL; alt: string } | undefined;
}

const { title, description, canonical, article, image } = Astro.props;
const rssUrl = SITE.rssPath ? new URL(SITE.rssPath, Astro.site) : undefined;

// 공통 SEO 메타데이터(TECH.md #8.1). 레이아웃은 이 컴포넌트 하나로 출력한다.
---

<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{
  image && (
    <>
      <meta property="og:image" content={image.url} />
      <meta property="og:image:alt" content={image.alt} />
    </>
  )
}
{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )}
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image.url} />}

{rssUrl && <link rel="alternate" type="application/rss+xml" title={SITE.name} href={rssUrl} />}
<link rel="sitemap" href="/sitemap-index.xml" />
