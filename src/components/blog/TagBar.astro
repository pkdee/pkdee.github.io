---
import ArrowRightIcon from '../../assets/icons/arrow-right.svg';
import TagChip from './TagChip.astro';
import type { TagSummary } from '../../lib/posts';

interface Props {
  /** 글 수가 많은 순으로 정렬한 태그 */
  tags: TagSummary[];
}

const { tags } = Astro.props;

// 모바일과 태블릿 글 목록 위의 주요 태그 줄(DESIGN.md #8.9). 칩 줄만 가로로 스크롤한다.
const MAX_TAGS = 8;
---

<nav aria-label="주요 태그" class="flex flex-col gap-sm">
  <div class="flex items-center justify-between">
    <p class="text-label text-muted">주요 태그</p>
    <a href="/tags/" class="flex items-center gap-xxs text-label text-primary underline">
      모든 태그
      <span aria-hidden="true"><ArrowRightIcon /></span>
    </a>
  </div>
  <ul class="flex gap-xs overflow-x-auto pb-[14px]">
    {
      tags.slice(0, MAX_TAGS).map((tag) => (
        <li class="shrink-0">
          <TagChip name={tag.name} />
        </li>
      ))
    }
  </ul>
</nav>
