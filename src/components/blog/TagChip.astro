---
import TagIcon from './TagIcon.astro';
import { tagUrl } from '../../lib/tags';

interface Props {
  name: string;
  /** 글 수. 태그 목록 페이지(/tags/)에서만 쓴다. */
  count?: number;
}

const { name, count } = Astro.props;

// 태그 칩(DESIGN.md #8.6). 태그 페이지로 가는 링크이고 칩에는 브랜드 색을 쓰지 않는다.
---

<a
  href={tagUrl(name)}
  lang="en"
  class="inline-flex items-center gap-1.5 rounded-pill border border-border bg-surface px-sm py-xxs text-label whitespace-nowrap text-muted hover:text-primary focus-visible:-outline-offset-2"
>
  <TagIcon name={name} size={14} variant="mono" />
  {name}
  {
    count !== undefined && (
      <span class="text-body-sm" lang="ko">
        <span class="sr-only">글 </span>
        {count}
        <span class="sr-only">개</span>
      </span>
    )
  }
</a>
