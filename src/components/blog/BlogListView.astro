---
import PostListView from './PostListView.astro';
import { SITE } from '../../lib/site';
import { byPopularity, summarizeTags, type BlogPost } from '../../lib/posts';

interface Props {
  /** 현재 페이지의 글 */
  posts: BlogPost[];
  /** 공개된 글 전체(게시일 최신순) */
  allPosts: BlogPost[];
  currentPage: number;
  lastPage: number;
}

const { posts, allPosts, currentPage, lastPage } = Astro.props;
const blogPageUrl = (page: number) => (page === 1 ? '/blog/' : `/blog/page/${page}/`);
const popularTags = summarizeTags(allPosts).sort(byPopularity);

// 블로그 목록(DESIGN.md #5.6). 모바일은 주요 태그 줄, 데스크톱은 태그 패널(전체 글이 현재 항목)을 둔다.
---

<PostListView
  posts={posts}
  total={allPosts.length}
  currentPage={currentPage}
  lastPage={lastPage}
  pageHref={blogPageUrl}
  popularTags={popularTags}
  allPostCount={allPosts.length}
  current="all"
  showTagBar
>
  <div slot="heading" class="flex flex-col gap-xs break-keep">
    <h1 lang="en" class="text-heading-lg text-text md:text-heading-xl">Blog</h1>
    <p class="text-body text-muted">{SITE.description}</p>
  </div>
</PostListView>
