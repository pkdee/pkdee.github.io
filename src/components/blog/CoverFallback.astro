---
import TagIcon from './TagIcon.astro';
import { LOGOS } from '../../lib/tag-logos';
import { findTag } from '../../lib/tags';

interface Props {
  tags: readonly string[];
  /** medium: 데스크톱 글 목록, small: 모바일 글 목록 */
  size: 'medium' | 'small';
}

const { tags, size } = Astro.props;
const logoTag = tags.find((tag) => findTag(tag)?.logo);
const logoKey = logoTag ? findTag(logoTag)?.logo : undefined;
const firstTag = tags[0];
const iconSize = size === 'medium' ? 40 : 28;

// 표지가 없는 글의 대체 표지(DESIGN.md #8.2, #8.11). 장식이므로 대체 텍스트가 없다.
// 로고가 있는 첫 태그의 Brand 로고와 브랜드 색 12% 배경을 쓴다.
// 그런 태그가 없으면 # 아이콘, 첫 태그 이름(medium만), Muted Text 8% 배경을 쓴다.
---

<div
  class:list={[
    'flex size-full flex-col items-center justify-center gap-xs',
    logoKey
      ? LOGOS[logoKey].coverClass
      : 'bg-[color-mix(in_srgb,var(--color-muted)_8%,var(--color-surface))]',
  ]}
  aria-hidden="true"
>
  {
    logoTag ? (
      <TagIcon name={logoTag} size={iconSize} variant="brand" />
    ) : (
      <>
        <TagIcon name="" size={iconSize} variant="brand" />
        {size === 'medium' && firstTag && <span class="font-mono text-code text-muted">{firstTag}</span>}
      </>
    )
  }
</div>
