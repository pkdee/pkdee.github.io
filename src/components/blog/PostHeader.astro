---
import CalendarIcon from '../../assets/icons/calendar.svg';
import TagChip from './TagChip.astro';
import { formatDate, isoDate } from '../../lib/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date | undefined;
  /** 예상 읽기 시간(분, TECH.md #6.5) */
  readingMinutes: number;
  tags: readonly string[];
}

const { title, description, pubDate, updatedDate, readingMinutes, tags } = Astro.props;

// 글 머리: 제목, 설명, 날짜(게시일, 수정일, 읽기 시간), 태그 순서(DESIGN.md #8.3)
// 제목과 게시일은 검색 결과에 쓰는 메타데이터이다. 날짜 줄과 태그는 본문 색인에서 빼지만
// data-pagefind-ignore 기본값(index)은 메타데이터를 그대로 읽는다(TECH.md #6.10).
---

<header class="flex flex-col gap-sm break-keep">
  <h1 class="text-heading-xl text-text" data-pagefind-meta="title">{title}</h1>
  <p class="text-body text-muted">{description}</p>
  <p class="flex items-center gap-xs text-body-sm text-muted" data-pagefind-ignore>
    <span aria-hidden="true"><CalendarIcon /></span>
    <span>
      <time datetime={isoDate(pubDate)} data-pagefind-meta="date">{formatDate(pubDate)}</time> 게시
      {
        updatedDate && (
          <>
            {' · '}
            <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time> 수정
          </>
        )
      }
      {` · ${readingMinutes}분 읽기`}
    </span>
  </p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-xs" aria-label="태그" data-pagefind-ignore>
        {tags.map((tag) => (
          <li>
            <TagChip name={tag} />
          </li>
        ))}
      </ul>
    )
  }
</header>
