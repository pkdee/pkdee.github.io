---
import SearchIcon from '../../assets/icons/search.svg';
import CloseIcon from '../../assets/icons/close.svg';
import SearchField from './SearchField.astro';
import SearchResults from './SearchResults.astro';

interface Props {
  /** desktop은 헤더의 입력창과 결과 패널, mobile은 검색 버튼과 전체 화면 검색이다. */
  variant: 'desktop' | 'mobile';
}

const { variant } = Astro.props;

// 헤더 검색(DESIGN.md #8.15, ARCHITECTURE.md #7.3). 인덱스는 빌드 후 Pagefind가 만들고,
// 검색 스크립트는 입력창에 처음 포커스할 때 불러온다. JavaScript가 없으면 BaseLayout의
// noscript 스타일이 data-search-ui 요소를 숨긴다.
---

{
  variant === 'desktop' ? (
    <div data-search-ui data-search="desktop" class="relative">
      <SearchField class="w-[280px]" />
      <div
        data-search-panel
        class="absolute top-full right-0 z-20 mt-xs hidden max-h-[70vh] w-[480px] flex-col gap-xxs rounded-md border border-border bg-surface-raised p-xs shadow-popover"
      >
        <SearchResults variant="desktop" />
      </div>
    </div>
  ) : (
    <>
      <button
        id="site-search-open"
        type="button"
        data-search-ui
        class="flex size-10 items-center justify-center rounded-md hover:bg-surface"
        aria-label="검색"
        aria-haspopup="dialog"
      >
        <span aria-hidden="true">
          <SearchIcon />
        </span>
      </button>
      <dialog
        id="site-search-dialog"
        data-search="mobile"
        aria-label="검색"
        class="m-0 h-dvh max-h-none w-full max-w-none bg-background text-text open:flex open:flex-col"
      >
        <div class="flex shrink-0 items-center gap-xs border-b border-border py-sm pr-sm pl-md">
          <SearchField class="flex-1" />
          <button
            type="button"
            data-search-close
            class="flex size-10 shrink-0 items-center justify-center rounded-md hover:bg-surface"
            aria-label="검색 닫기"
          >
            <span aria-hidden="true">
              <CloseIcon />
            </span>
          </button>
        </div>
        <div data-search-panel class="hidden min-h-0 flex-1 flex-col">
          <SearchResults variant="mobile" />
        </div>
      </dialog>
    </>
  )
}

<script>
  /** Pagefind JavaScript API에서 쓰는 부분만 적는다(pagefind.app/docs/api). */
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
  }
  interface Pagefind {
    preload: (query: string) => Promise<void>;
    debouncedSearch: (
      query: string,
    ) => Promise<{ results: { data: () => Promise<PagefindResultData> }[] } | null>;
  }

  // 빌드 결과에만 있는 파일이라 Vite가 경로를 분석하지 않게 변수로 넘긴다.
  const PAGEFIND_URL = '/pagefind/pagefind.js';
  const MAX_RESULTS = 10;

  let pagefindPromise: Promise<Pagefind> | undefined;
  const loadPagefind = () => {
    if (!pagefindPromise) {
      pagefindPromise = import(/* @vite-ignore */ PAGEFIND_URL) as Promise<Pagefind>;
      // 실패하면 다음 검색에서 다시 불러온다.
      pagefindPromise.catch(() => (pagefindPromise = undefined));
    }
    return pagefindPromise;
  };

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);

  function setupSearch(root: HTMLElement, onEscape: () => void) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const panel = root.querySelector<HTMLElement>('[data-search-panel]');
    const status = root.querySelector<HTMLElement>('[data-search-status]');
    const list = root.querySelector<HTMLUListElement>('[data-search-list]');
    const empty = root.querySelector<HTMLElement>('[data-search-empty]');
    const template = root.querySelector<HTMLTemplateElement>('[data-search-item]');
    if (!input || !panel || !status || !list || !empty || !template) return undefined;

    let requestId = 0;
    const setVisible = (element: HTMLElement, visible: boolean) => {
      element.classList.toggle('hidden', !visible);
      element.classList.toggle('flex', visible);
    };
    const setPanelOpen = (open: boolean) => setVisible(panel, open);

    const render = (query: string, total: number, results: PagefindResultData[]) => {
      const shown = total > results.length ? `, 앞의 ${results.length}개를 보여 줍니다` : '';
      status.textContent = `“${query}” 검색 결과 ${total}개${shown}`;
      setVisible(empty, total === 0);
      list.replaceChildren(
        ...results.map((result) => {
          const item = template.content.cloneNode(true) as DocumentFragment;
          const link = item.querySelector('a');
          if (link) link.href = result.url;
          // meta는 가공되지 않은 값이므로 textContent로 넣는다.
          const title = item.querySelector('[data-search-title]');
          if (title) title.textContent = result.meta.title ?? result.url;
          const date = item.querySelector('[data-search-date]');
          if (date) date.textContent = result.meta.date ?? '';
          // excerpt는 Pagefind가 HTML을 이스케이프한 뒤 <mark>만 넣은 값이다(TECH.md #6.10).
          const excerpt = item.querySelector('[data-search-excerpt]');
          if (excerpt) excerpt.innerHTML = result.excerpt;
          return item;
        }),
      );
      setPanelOpen(true);
    };

    const search = async () => {
      const query = input.value.trim();
      const id = ++requestId;
      if (!query) {
        setPanelOpen(false);
        return;
      }
      try {
        const pagefind = await loadPagefind();
        void pagefind.preload(query);
        const response = await pagefind.debouncedSearch(query);
        if (response === null || id !== requestId) return;
        const results = await Promise.all(
          response.results.slice(0, MAX_RESULTS).map((result) => result.data()),
        );
        if (id !== requestId) return;
        render(query, response.results.length, results);
      } catch {
        if (id !== requestId) return;
        // 개발 서버에는 인덱스가 없다. 검색은 빌드 후 preview에서 동작한다(TECH.md #6.10).
        status.textContent = '검색을 불러오지 못했습니다. 잠시 뒤 다시 시도해 주세요.';
        list.replaceChildren();
        setVisible(empty, false);
        setPanelOpen(true);
      }
    };

    input.addEventListener('focus', () => loadPagefind().catch(() => undefined));
    // 검색어가 남아 있으면 입력창을 누를 때 이전 결과를 다시 연다. Esc 뒤 포커스 복귀에서는 열지 않는다.
    input.addEventListener('click', () => {
      if (input.value.trim() && status.textContent) setPanelOpen(true);
    });
    input.addEventListener('input', () => void search());

    // ↓는 첫 결과로, ↑↓는 결과 사이를 옮기고, 첫 결과에서 ↑는 입력창으로 돌아간다. Enter는 링크 기본 동작이다.
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        onEscape();
        return;
      }
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const items = [...list.querySelectorAll<HTMLAnchorElement>('a')];
      if (items.length === 0) return;
      if (event.target === input) {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault();
        setPanelOpen(true);
        items[0]?.focus();
        return;
      }
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (index === -1) return;
      event.preventDefault();
      const next = event.key === 'ArrowDown' ? Math.min(index + 1, items.length - 1) : index - 1;
      (next < 0 ? input : items[next])?.focus();
    });

    return { input, setPanelOpen };
  }

  // 데스크톱: 헤더 입력창과 결과 패널. Esc는 패널을 닫고 입력창으로 포커스를 돌려준다.
  const desktopRoot = document.querySelector<HTMLElement>('[data-search="desktop"]');
  const desktop =
    desktopRoot &&
    setupSearch(desktopRoot, () => {
      desktop?.setPanelOpen(false);
      desktop?.input.focus();
    });
  if (desktopRoot && desktop) {
    desktop.input.placeholder = isMac ? '검색 (⌘K)' : '검색 (Ctrl K)';
    // 패널 바깥을 누르거나 포커스가 검색 밖으로 나가면 닫는다.
    document.addEventListener('pointerdown', (event) => {
      if (!desktopRoot.contains(event.target as Node)) desktop.setPanelOpen(false);
    });
    desktopRoot.addEventListener('focusout', (event) => {
      if (!desktopRoot.contains(event.relatedTarget as Node | null)) desktop.setPanelOpen(false);
    });
  }

  // 모바일: 검색 버튼과 전체 화면 검색(dialog). Esc는 검색을 닫고 버튼으로 포커스를 돌려준다.
  const openButton = document.getElementById('site-search-open');
  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-search="mobile"]');
  const mobile = dialog && setupSearch(dialog, () => dialog.close());
  const openDialog = () => {
    if (!dialog || !mobile || dialog.open) return;
    dialog.showModal();
    mobile.input.focus();
  };
  if (openButton && dialog && mobile) {
    openButton.addEventListener('click', openDialog);
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => openButton.focus());
  }

  // ⌘K(macOS) 또는 Ctrl K로 검색을 연다. 브라우저 기본 동작(주소 표시줄 검색)은 막는다.
  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(isMac ? event.metaKey : event.ctrlKey)) return;
    if (event.shiftKey || event.altKey) return;
    event.preventDefault();
    // 화면 폭에 따라 보이는 쪽을 연다. 숨겨진 요소는 offsetParent가 null이다.
    if (desktop && desktopRoot?.offsetParent) {
      desktop.input.focus();
      desktop.input.select();
    } else {
      openDialog();
    }
  });
</script>
