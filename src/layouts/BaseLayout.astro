---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead, { type ArticleMeta } from '../components/layout/SeoHead.astro';
import { SITE } from '../lib/site';

interface Props {
  /** 페이지 제목. 사이트 이름은 뒤에 붙인다. */
  title: string;
  description?: string;
  /** 다른 곳에 먼저 발행한 글의 원문 주소(frontmatter canonicalUrl). 없으면 이 페이지 주소이다. */
  canonicalUrl?: string | undefined;
  article?: ArticleMeta | undefined;
  image?: { url: URL; alt: string } | undefined;
}

const { title, description = SITE.description, canonicalUrl, article, image } = Astro.props;
const fullTitle = `${title} | ${SITE.name}`;
// canonical은 항상 운영 주소(site) 기준이다. dev, preview 주소를 쓰지 않는다(ARCHITECTURE.md #8.3).
const canonical = canonicalUrl ? new URL(canonicalUrl) : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{fullTitle}</title>
    <SeoHead
      title={fullTitle}
      description={description}
      canonical={canonical}
      article={article}
      image={image}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <noscript>
      <!-- JavaScript가 없으면 모바일 메뉴 버튼이 동작하지 않으므로 메뉴를 펼쳐 둔다. 검색은 숨긴다. -->
      <style>
        [data-search-ui] { display: none !important; }
        @media (width < 48rem) {
          #site-menu-panel { display: block !important; }
          #site-menu-toggle { display: none !important; }
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-xs focus:left-xs focus:z-10 focus:rounded-sm focus:bg-background focus:px-sm focus:py-xs focus:text-label"
    >
      본문으로 건너뛰기
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
