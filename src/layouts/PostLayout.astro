---
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import ArticleLayout from './ArticleLayout.astro';
import PostHeader from '../components/blog/PostHeader.astro';
import type { BlogPost } from '../lib/posts';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, canonicalUrl } = post.data;
// 공유 미리보기 이미지는 대표 이미지가 있을 때만 쓴다. 폭 1200px PNG로 만든다.
// 기본 형식인 WebP를 읽지 못하는 미리보기 서비스가 있을 수 있어 투명도도 지키는 PNG를 쓴다.
const ogImage = cover
  ? {
      url: new URL((await getImage({ src: cover, width: 1200, format: 'png' })).src, Astro.site),
      alt: coverAlt ?? '',
    }
  : undefined;

// 글 상세(DESIGN.md #5.5, #8.3)
---

<ArticleLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
  image={ogImage}
  headings={headings}
  searchable
>
  <PostHeader
    slot="header"
    title={title}
    description={description}
    pubDate={pubDate}
    updatedDate={updatedDate}
    tags={tags}
  />
  <slot />
</ArticleLayout>
