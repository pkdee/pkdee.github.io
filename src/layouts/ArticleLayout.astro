---
import type { ComponentProps } from 'astro/types';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
// global.css(BaseLayout) 다음에 불러와야 CSS 레이어 순서가 Tailwind와 같아진다.
import '../styles/prose.css';
import TableOfContents from '../components/blog/TableOfContents.astro';
import { tocHeadings } from '../lib/posts';

type Props = ComponentProps<typeof BaseLayout> & {
  headings: MarkdownHeading[];
  /** 검색 색인에 넣을지. 글 상세만 켠다(ARCHITECTURE.md #7.3). */
  searchable?: boolean;
};

const { headings, searchable = false, title, description, canonicalUrl, article, image } = Astro.props;
const toc = tocHeadings(headings);

// 본문 상세의 공통 틀(DESIGN.md #5.5, #8.3). 글과 프로젝트 상세가 함께 쓴다.
// 머리는 header 슬롯으로 받는다. 데스크톱(1024px 이상)은 본문 오른쪽에 목차를 두고,
// 그보다 좁으면 본문 위에 접이식 목차를 둔다.
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  article={article}
  image={image}
>
  <div class="px-(--layout-gutter) pt-lg pb-xxxl md:pt-xxl">
    <div class="mx-auto flex max-w-[calc(var(--container-article)+var(--spacing-xxl)+15rem)] justify-center gap-xxl">
      <article
        class="flex max-w-article min-w-0 flex-1 flex-col gap-xl"
        data-pagefind-body={searchable ? '' : undefined}
      >
        <slot name="header" />
        <hr class="border-border" />
        {
          toc.length > 0 && (
            <div class="lg:hidden" data-pagefind-ignore>
              <TableOfContents headings={toc} variant="collapsible" />
            </div>
          )
        }
        <div class="prose">
          <slot />
        </div>
      </article>
      {
        toc.length > 0 && (
          <aside class="hidden w-60 shrink-0 pt-xxl lg:block">
            <div class="sticky top-lg max-h-[calc(100dvh-2*var(--spacing-lg))] overflow-y-auto">
              <TableOfContents headings={toc} variant="sidebar" />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // 코드 복사(DESIGN.md #8.5). 클립보드를 쓸 수 없으면 버튼을 숨긴 채로 둔다.
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.code-block-copy')) {
      const label = button.querySelector('.code-block-copy-label');
      const code = button.closest('.code-block')?.querySelector('pre code');
      if (!label || !code) continue;

      button.hidden = false;
      let resetTimer: number | undefined;
      button.addEventListener('click', async () => {
        // 브라우저가 클립보드 권한을 막으면 실패를 글자로 알린다.
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.dataset.copied = '';
          label.textContent = '복사됨';
        } catch {
          label.textContent = '복사 실패';
        }
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          delete button.dataset.copied;
          label.textContent = '복사';
        }, 2000);
      });
    }
  }

  // 목차의 현재 섹션 표시(DESIGN.md #8.4). 화면 위쪽을 지난 마지막 제목을 현재 섹션으로 본다.
  // 글 끝의 짧은 섹션은 그 선까지 올라가지 못하므로 두 가지를 더한다.
  // 1. 목차를 누르거나 #제목 주소로 열면 그 제목을 고정하고, 사용자가 직접 스크롤할 때 푼다.
  // 2. 직접 스크롤해 페이지 끝에 닿으면 마지막 제목을 현재 섹션으로 본다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const slugs = [...new Set(links.map((link) => link.dataset.tocLink ?? ''))];
  const headings = slugs
    .map((slug) => document.getElementById(slug))
    .filter((heading): heading is HTMLElement => heading !== null);

  if (headings.length > 0) {
    const threshold = 120;
    let current: string | undefined;
    let pinned: string | undefined;
    let ticking = false;

    const setCurrent = (next: string | undefined) => {
      if (next === current) return;
      current = next;
      for (const link of links) {
        if (link.dataset.tocLink === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    const isAtBottom = () => {
      const { scrollHeight, clientHeight } = document.documentElement;
      return scrollHeight > clientHeight && window.scrollY + clientHeight >= scrollHeight - 2;
    };

    const update = () => {
      ticking = false;
      if (pinned) return;
      if (isAtBottom()) {
        setCurrent(headings.at(-1)?.id);
        return;
      }
      const passed = headings.filter((heading) => heading.getBoundingClientRect().top <= threshold);
      setCurrent(passed.at(-1)?.id);
    };

    const pin = (slug: string) => {
      if (!slugs.includes(slug)) return;
      pinned = slug;
      setCurrent(slug);
    };

    // 고정은 사용자가 직접 스크롤하려는 입력에서만 푼다. 목차 링크가 일으킨 스크롤에는 풀리지 않는다.
    // 푼 뒤의 표시는 이어지는 scroll 이벤트가 정한다.
    const unpin = () => {
      pinned = undefined;
    };
    const SCROLL_KEYS = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ']);
    window.addEventListener('wheel', unpin, { passive: true });
    window.addEventListener('touchmove', unpin, { passive: true });
    window.addEventListener('pointerdown', unpin);
    window.addEventListener('keydown', (event) => {
      if (SCROLL_KEYS.has(event.key)) unpin();
    });

    // pointerdown이 먼저 고정을 풀고, 이어지는 click이 누른 제목으로 다시 고정한다.
    for (const link of links) {
      link.addEventListener('click', () => pin(link.dataset.tocLink ?? ''));
    }
    // 뒤로·앞으로 가기로 주소의 #제목이 바뀌어도 그 제목을 고정한다.
    window.addEventListener('hashchange', () => pin(decodeURIComponent(location.hash.slice(1))));

    if (location.hash) pin(decodeURIComponent(location.hash.slice(1)));
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
